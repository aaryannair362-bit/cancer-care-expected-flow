# Copy this file to .env for local development (server.py loads .env automatically).
# On Vercel, set these as Environment Variables in the project dashboard instead —
# a .env file is never read there.

# Required for persistence once deployed (local dev falls back to SQLite without these).
# Create a free database at https://turso.tech, then:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. Local-only: which port `python server.py` binds to.
# Do NOT add this in the Vercel dashboard — Vercel manages its own HTTP entrypoint,
# and setting PORT there (especially blank) will crash every request.
PORT=8765

# Optional. Local-only: which interface `python server.py` binds to (default 127.0.0.1).
HOST=127.0.0.1

# Optional. Local sqlite file path, used ONLY when TURSO_DATABASE_URL above is unset —
# Turso always takes precedence once configured, so this has no effect on Vercel.
# CCA_DB_PATH=cca_v12.sqlite3

# PC8.0 connected-multidisciplinary auth. Individual named-user + PIN login (see
# DEMO_USER_CREDENTIALS.txt, regenerated on every server start) is now the primary
# sign-in path. The legacy shared role + PIN login used by the acceptance/regression
# suites keeps working by default; set CCA_ALLOW_SHARED_ROLE_LOGIN=0 once real named
# accounts are trusted end-to-end. CCA_DEPLOYMENT_MODE=production refuses to start at
# all if shared-role login is still enabled, as a last-resort safety net.
CCA_DEMO_PIN=2026
CCA_DEPLOYMENT_MODE=validation
CCA_ALLOW_SHARED_ROLE_LOGIN=1
