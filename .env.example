# Copy this file to .env for local development (server.py loads .env automatically).
# On Vercel, set these as Environment Variables in the project dashboard instead —
# a .env file is never read there.

# Required for persistence once deployed (local dev falls back to SQLite without these).
# Create a free database at https://turso.tech, then:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. Demo login PIN for every role. Defaults to 2026 if unset — since this
# repo is public, set a real value in Vercel rather than relying on the default.
CCA_DEMO_PIN=

# Optional. Local-only: which port `python server.py` binds to. Ignored on Vercel.
PORT=8765
